# ============================================================
#  Room Mates · configuration
#  Copy this file to `.env` and fill in your own values.
#  Leave it EMPTY and the app still works — it just saves to
#  your browser instead of a shared database.
# ============================================================

# --- Frontend (safe to expose; protected by Row Level Security) ---
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key

# The home this deployment points at (from schema.sql seed)
VITE_FLAT_ID=00000000-0000-0000-0000-000000000402


# ============================================================
#  Server-side secrets — set these in
#  Supabase → Edge Functions → Secrets.  NEVER commit them.
# ============================================================

# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # bypasses RLS, server only

# Web Push keys — generate with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=BEl62iUYgUiv...
# VAPID_PRIVATE_KEY=UUxI4O8-Fbr...

# WhatsApp via Twilio (free sandbox works)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email via Resend
# RESEND_API_KEY=re_xxxxxxxx
